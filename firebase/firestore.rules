rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUsername(value) {
      return value is string &&
        value.size() >= 3 && value.size() <= 20 &&
        value.matches('^[a-z0-9_][a-z0-9_.]*[a-z0-9_]$') &&
        !value.matches('.*\\.\\..*') &&
        !(value in [
          'admin', 'administrator', 'api', 'apple', 'capyflow', 'everyone',
          'firebase', 'google', 'help', 'here', 'moderator', 'mods', 'null',
          'official', 'owner', 'root', 'security', 'staff', 'support',
          'system', 'undefined'
        ]);
    }

    function usernameCooldownElapsed(data) {
      return data.get('usernameIsGenerated', false) == true ||
        !data.keys().hasAny(['usernameChangedAt']) ||
        request.time >= data.usernameChangedAt + duration.value(14, 'd');
    }

    // One shared room, readable only by Google-authenticated CapyFlow accounts.
    function googleAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /globalChatSenders/{uid} {
      allow get: if owns(uid) && googleAccount();
      allow list, delete: if false;
      allow create, update: if owns(uid) && googleAccount() &&
        request.resource.data.keys().hasOnly(['lastSentAt', 'messageID']) &&
        request.resource.data.lastSentAt == request.time &&
        request.resource.data.messageID is string &&
        (!exists(/databases/$(database)/documents/globalChatSenders/$(uid)) ||
          request.time >= resource.data.lastSentAt + duration.value(2, 's')) &&
        getAfter(/databases/$(database)/documents/globalMessages/$(request.resource.data.messageID)).data.senderID == uid &&
        getAfter(/databases/$(database)/documents/globalMessages/$(request.resource.data.messageID)).data.createdAt == request.time;
    }
    match /globalMessages/{messageID} {
      allow get: if googleAccount();
      allow list: if googleAccount() && request.query.limit <= 50;
      allow create: if googleAccount() &&
        request.resource.data.keys().hasOnly(['senderID', 'text', 'createdAt']) &&
        request.resource.data.senderID == request.auth.uid &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 4000 && request.resource.data.text.matches('[\\s\\S]*\\S[\\s\\S]*') &&
        request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/globalChatSenders/$(request.auth.uid)).data.messageID == messageID &&
        getAfter(/databases/$(database)/documents/globalChatSenders/$(request.auth.uid)).data.lastSentAt == request.time;
      allow update, delete: if false;
    }

    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow create: if owns(uid) &&
        request.resource.data.keys().hasOnly(['username', 'usernameKey', 'usernameIsGenerated', 'displayName', 'bio', 'avatarURL', 'avatarData', 'createdAt', 'updatedAt']) &&
        validUsername(request.resource.data.username) &&
        request.resource.data.usernameKey == request.resource.data.username &&
        request.resource.data.usernameIsGenerated == true &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 1 &&
        request.resource.data.displayName.size() <= 60 &&
        request.resource.data.bio is string &&
        request.resource.data.bio.size() <= 160 &&
        (!request.resource.data.keys().hasAny(['avatarData']) ||
          (request.resource.data.avatarData is bytes && request.resource.data.avatarData.size() <= 131072)) &&
        getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if owns(uid) &&
        request.resource.data.keys().hasOnly(['username', 'usernameKey', 'usernameIsGenerated', 'usernameChangedAt', 'displayName', 'bio', 'avatarURL', 'avatarData', 'createdAt', 'updatedAt']) &&
        validUsername(request.resource.data.username) &&
        request.resource.data.usernameKey == request.resource.data.username &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 1 &&
        request.resource.data.displayName.size() <= 60 &&
        request.resource.data.bio is string &&
        request.resource.data.bio.size() <= 160 &&
        (!request.resource.data.keys().hasAny(['avatarData']) ||
          (request.resource.data.avatarData is bytes && request.resource.data.avatarData.size() <= 131072)) &&
        getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid &&
        (
          (
            request.resource.data.username == resource.data.get('username', '') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usernameKey', 'usernameIsGenerated', 'displayName', 'bio', 'avatarURL', 'avatarData', 'updatedAt']) &&
            request.resource.data.get('usernameIsGenerated', false) == resource.data.get('usernameIsGenerated', false)
          ) ||
          (
            !validUsername(resource.data.get('username', '')) &&
            request.resource.data.usernameIsGenerated == true
          ) ||
          (
            request.resource.data.username != resource.data.get('username', '') &&
            usernameCooldownElapsed(resource.data) &&
            request.resource.data.usernameIsGenerated == false &&
            request.resource.data.usernameChangedAt == request.time &&
            (resource.data.get('username', '') == '' ||
              !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username)) ||
              getAfter(/databases/$(database)/documents/usernames/$(resource.data.username)).data.get('uid', '') != uid)
          )
        );
      allow delete: if owns(uid) &&
        !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username));
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validUsername(username) &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == username;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid &&
        (
          !existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)) ||
          getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username != username
        );
    }

    match /follows/{edgeID} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.followerID == request.auth.uid &&
        request.resource.data.followingID != request.auth.uid &&
        edgeID == request.resource.data.followerID + '_' + request.resource.data.followingID;
      allow update: if false;
      allow delete: if signedIn() &&
        (resource.data.followerID == request.auth.uid || resource.data.followingID == request.auth.uid);
    }

    match /activitySettings/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create, update: if owns(uid) &&
        request.resource.data.keys().hasOnly(['sharing', 'updatedAt']) &&
        request.resource.data.sharing is bool && request.resource.data.updatedAt == request.time &&
        (request.resource.data.sharing == true ||
          !existsAfter(/databases/$(database)/documents/listeningActivity/$(uid)));
      allow delete: if owns(uid);
    }
    match /listeningActivity/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow create, update: if owns(uid) &&
        getAfter(/databases/$(database)/documents/activitySettings/$(uid)).data.sharing == true &&
        request.resource.data.keys().hasOnly(['title', 'artist', 'videoID', 'artworkURL', 'playing', 'updatedAt', 'expiresAt']) &&
        request.resource.data.title is string && request.resource.data.title.size() <= 300 &&
        request.resource.data.artist is string && request.resource.data.artist.size() <= 300 &&
        request.resource.data.videoID is string && request.resource.data.videoID.size() <= 128 &&
        request.resource.data.artworkURL is string && request.resource.data.artworkURL.size() <= 2048 &&
        request.resource.data.playing is bool && request.resource.data.updatedAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time - duration.value(5, 'm') &&
        request.resource.data.expiresAt <= request.time + duration.value(10, 'm');
      allow delete: if owns(uid);
    }

    // Personal libraries are account-private, independently of social sharing.
    match /users/{uid}/library/{playlistID} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) &&
        request.resource.data.keys().hasOnly(['playlistID', 'deleted', 'payload', 'cover', 'updatedAt']) &&
        request.resource.data.playlistID is string && request.resource.data.playlistID.size() <= 1000 &&
        request.resource.data.deleted is bool && request.resource.data.updatedAt == request.time &&
        (request.resource.data.deleted == true ||
          (request.resource.data.payload is bytes && request.resource.data.payload.size() <= 750000)) &&
        (!('cover' in request.resource.data) ||
          (request.resource.data.cover is bytes && request.resource.data.cover.size() <= 128000));
      allow delete: if owns(uid);
    }

    // Installation-scoped FCM tokens stay private to their authenticated owner.
    match /users/{uid}/devices/{deviceID} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid) &&
        request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt']) &&
        request.resource.data.token is string && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 4096 &&
        request.resource.data.platform == 'android' && request.resource.data.updatedAt == request.time;
    }

    match /playlists/{playlistID} {
      function isMember(data) {
        return signedIn() && request.auth.uid in data.memberIDs;
      }

      allow read: if isMember(resource.data);
      allow create: if signedIn() &&
        request.resource.data.ownerID == request.auth.uid &&
        request.resource.data.memberIDs == [request.auth.uid];
      allow update: if signedIn() &&
        request.resource.data.ownerID == resource.data.ownerID &&
        request.resource.data.memberIDs is list &&
        resource.data.ownerID in request.resource.data.memberIDs &&
        (
          request.auth.uid == resource.data.ownerID ||
          (
            isMember(resource.data) &&
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tracks', 'updatedAt']) ||
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIDs', 'updatedAt']) &&
                request.resource.data.memberIDs == resource.data.memberIDs.removeAll([request.auth.uid])))
          )
        );
      allow delete: if signedIn() && resource.data.ownerID == request.auth.uid;
    }

    match /conversations/{threadID} {
      function participant(data) { return signedIn() && request.auth.uid in data.memberIDs; }
      function validThread(data) {
        return data.keys().hasOnly(['memberIDs', 'createdAt', 'updatedAt', 'lastMessageID', 'lastText', 'lastSenderID', 'readMessageIDs']) &&
          data.memberIDs is list && data.memberIDs.size() == 2 && data.memberIDs[0] is string && data.memberIDs[1] is string &&
          data.memberIDs[0] != data.memberIDs[1] && threadID == data.memberIDs[0] + '_' + data.memberIDs[1] &&
          data.lastMessageID is string && data.lastMessageID.size() <= 128 &&
          data.lastText is string && data.lastText.size() > 0 && data.lastText.size() <= 4000 &&
          data.lastSenderID in data.memberIDs && data.readMessageIDs is map &&
          data.readMessageIDs.keys().hasOnly(data.memberIDs) && data.readMessageIDs.keys().hasAll(data.memberIDs);
      }
      function committedMessage(data) {
        let message = getAfter(/databases/$(database)/documents/conversations/$(threadID)/messages/$(data.lastMessageID)).data;
        return message.senderID == request.auth.uid && message.text == data.lastText && message.createdAt == request.time &&
          data.lastSenderID == request.auth.uid && data.updatedAt == request.time;
      }
      allow get: if signedIn() &&
        (exists(/databases/$(database)/documents/conversations/$(threadID)) ?
          participant(resource.data) : request.auth.uid in threadID.split('_'));
      allow list: if participant(resource.data) && request.query.limit <= 500;
      allow create: if participant(request.resource.data) && validThread(request.resource.data) &&
        request.resource.data.createdAt == request.time && committedMessage(request.resource.data) &&
        request.resource.data.readMessageIDs[request.auth.uid] == request.resource.data.lastMessageID &&
        request.resource.data.readMessageIDs[request.resource.data.memberIDs[0] == request.auth.uid ? request.resource.data.memberIDs[1] : request.resource.data.memberIDs[0]] == '' &&
        exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + (request.resource.data.memberIDs[0] == request.auth.uid ? request.resource.data.memberIDs[1] : request.resource.data.memberIDs[0])));
      allow update: if participant(resource.data) && validThread(request.resource.data) &&
        request.resource.data.memberIDs == resource.data.memberIDs && request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.readMessageIDs.diff(resource.data.readMessageIDs).affectedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.readMessageIDs[request.auth.uid] == request.resource.data.lastMessageID &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readMessageIDs']) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageID', 'lastText', 'lastSenderID', 'updatedAt', 'readMessageIDs']) &&
            request.resource.data.lastMessageID != resource.data.lastMessageID && committedMessage(request.resource.data))
        );
      allow delete: if false;

      // A recipient acknowledges the latest message after receiving it from the server.
      // Senders cannot forge another participant's delivery receipt.
      match /receipts/{recipientID} {
        function parentThread() { return get(/databases/$(database)/documents/conversations/$(threadID)).data; }
        allow get: if participant(parentThread());
        allow list: if false;
        allow create, update: if owns(recipientID) && participant(parentThread()) &&
          request.resource.data.keys().hasOnly(['messageID', 'receivedAt']) &&
          request.resource.data.messageID == parentThread().lastMessageID &&
          parentThread().lastSenderID != request.auth.uid &&
          request.resource.data.receivedAt == request.time;
        allow delete: if false;
      }

      match /messages/{messageID} {
        function thread() { return get(/databases/$(database)/documents/conversations/$(threadID)).data; }
        allow get: if participant(thread());
        allow list: if participant(thread()) && request.query.limit <= 50;
        allow create: if signedIn() &&
          request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(threadID)).data.memberIDs &&
          getAfter(/databases/$(database)/documents/conversations/$(threadID)).data.lastMessageID == messageID &&
          getAfter(/databases/$(database)/documents/conversations/$(threadID)).data.updatedAt == request.time &&
          request.resource.data.keys().hasOnly(['senderID', 'text', 'createdAt']) &&
          request.resource.data.senderID == request.auth.uid && request.resource.data.text is string &&
          request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000 && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
