# Safe default: only this Windows PC can connect.
BIND_HOST=127.0.0.1
PORT=8787

# Set both to true only for a trusted private network.
ALLOW_LAN=false
ALLOW_ANONYMOUS_LAN=false

# local = loopback or explicitly anonymous LAN; firebase = require a Firebase ID token.
AUTH_MODE=local
FIREBASE_PROJECT_ID=capyflow-aa6c5

# Paths can be absolute or relative to this backend directory.
YTDLP_PATH=./bin/yt-dlp.exe
CACHE_DIR=./cache
CACHE_MAX_BYTES=10737418240
CACHE_MAX_AGE_DAYS=30
CACHE_CONCURRENCY=2

RESOLVE_TIMEOUT_MS=45000
DOWNLOAD_TIMEOUT_MS=900000
RESOLVE_CACHE_SECONDS=900
DIAGNOSTIC_HISTORY=100

# Optional exact browser origin for development tools. iOS does not need CORS.
CORS_ORIGIN=

# Message push runs in this backend process and does not use Cloudflare.
# Enable only after installing a private service-account credential on this PC.
PUSH_NOTIFICATIONS=false
PUSH_SERVICE_ACCOUNT=
PUSH_STATE_FILE=./state/message-push.json
