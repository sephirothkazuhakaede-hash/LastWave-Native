{
  "name": "capyflow-media-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Small local-first media resolver, range proxy, and persistent cache for CapyFlow.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bootstrap.ps1",
    "update:yt-dlp": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bootstrap.ps1 -Force",
    "start": "node ./src/index.js",
    "dev": "node --watch ./src/index.js",
    "test": "node --test --test-isolation=none --test-force-exit",
    "benchmark": "node ./scripts/benchmark.mjs"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "firebase-admin": "14.5.0"
  },
  "overrides": {
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    }
  }
}
